   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "s = \u03c3(Conv(h\u2192C_k)(ReLU(Conv(C_k\u2192h)(GAP(X_ms)))))\nh = max(C_k / 4, 8)\nX_att = X_ms \u2299 s",
   "originalText": "s = \u03c3(Conv(h\u2192C_k)(ReLU(Conv(C_k\u2192h)(GAP(X_ms)))))\nh = max(C_k / 4, 8)\nX_att = X_ms \u2299 s",
   "fontSize": 20,
   "fontFamily": 2,
