   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "X_ms = Conv3\u00d73(X_cross) + Conv5\u00d75(X_cross)\n3\u00d73: boundary detail,  5\u00d75: wider context",
   "originalText": "X_ms = Conv3\u00d73(X_cross) + Conv5\u00d75(X_cross)\n3\u00d73: boundary detail,  5\u00d75: wider context",
